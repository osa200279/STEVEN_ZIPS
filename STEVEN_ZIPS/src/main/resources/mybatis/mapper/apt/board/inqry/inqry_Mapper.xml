<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="kr.or.ddit.domain.apt.board.inqry.mapper.IInqryMapper">

    <select id="getList"
            resultType="kr.or.ddit.domain.apt.board.inqry.dto.InqryDTO">
        /* IInqryMapper.getList */
        SELECT *
        FROM (
                 SELECT
                     ROW_NUMBER() OVER (ORDER BY abp.reg_dttm DESC) rnum
                      , abp.post_no       postNo       /* 게시글번호 */
                      , abp.board_no      boardNo      /* 게시판번호 */
                      , abp.ttl           ttl          /* 제목 */
                      , abp.cn            cn           /* 내용 */
                      , abp.wrtr_id       wrtrId       /* 작성자아이디 */
                      , abp.prrt_cd       prrtCd       /* 문의유형코드 */
                      , abp.reg_dttm      regDttm      /* 등록일시 */
                      , abp.mdf_dttm      mdfDttm      /* 수정일시 */
                      , abp.inq_cnt       inqCnt       /* 조회수 */
                      , abp.del_yn        delYn        /* 삭제여부 */
                      , abp.atch_file_id  atchFileId   /* 첨부파일아이디 */
                      , abp.opn_yn        opnYn        /* 공개여부 */
                      , abi.apt_cmplex_no aptCmplexNo  /* 아파트단지번호 */
                      , abi.board_ty_cd   boardTyCd    /* 게시판유형코드 */
                      , abi.board_nm      boardNm      /* 게시판명 */
                 FROM apt_board_post abp
                          JOIN apt_board_instance abi
                               ON abp.board_no = abi.board_no
                 WHERE abi.apt_cmplex_no = #{aptCmplexNo}
                   AND abi.board_ty_cd = #{boardTyCd}
                   AND abi.use_yn = 'Y'
                   AND abp.del_yn = 'N'
                   AND abp.wrtr_id = #{wrtrId}
             )
        WHERE rnum BETWEEN #{startRow} AND #{endRow}
    </select>

    <select id="getBoardNo"
            resultType="string">
        /* IInqryMapper.getBoardNo */
        SELECT MAX(abi.board_no)
        FROM apt_board_instance abi
        WHERE TRIM(abi.apt_cmplex_no) = TRIM(#{aptCmplexNo})
          AND TRIM(abi.board_ty_cd) = TRIM(#{boardTyCd})
          AND TRIM(abi.use_yn) = 'Y'
    </select>

    <insert id="insertInqry"
            parameterType="kr.or.ddit.domain.apt.board.inqry.dto.InqryDTO">
        /* IInqryMapper.insertInqry */
        INSERT INTO apt_board_post (
                                     post_no          /* 게시글번호 */
                                   , board_no         /* 게시판번호 */
                                   , ttl              /* 제목 */
                                   , cn               /* 내용 */
                                   , wrtr_id          /* 작성자ID */
                                   , prrt_cd          /* 문의유형코드 */
                                   , reg_dttm         /* 등록일시 */
                                   , mdf_dttm         /* 수정일시 */
                                   , inq_cnt          /* 조회수 */
                                   , del_yn           /* 삭제여부 */
                                   , atch_file_id     /* 첨부파일ID */
                                   , opn_yn           /* 공개여부 */
        ) VALUES (
                   'IQ' || TO_CHAR(SYSDATE, 'YYMMDDHH24MISS')
                 , #{boardNo}
                 , #{ttl}
                 , #{cn}
                 , #{wrtrId}
                 , #{prrtCd}
                 , SYSDATE
                 , NULL
                 , 0
                 , 'N'
                 , #{atchFileId}
                 , #{opnYn}
                 )
    </insert>

    <update id="deleteInqry">
        /* IInqryMapper.deleteInqry */
        UPDATE apt_board_post abp
        SET abp.del_yn = 'Y'
          , abp.mdf_dttm = SYSDATE
        WHERE abp.post_no = #{postNo}
          AND abp.wrtr_id = #{wrtrId}
          AND EXISTS (
            SELECT 1
            FROM apt_board_instance abi
            WHERE abi.board_no = abp.board_no
              AND abi.apt_cmplex_no = #{aptCmplexNo}
              AND abi.board_ty_cd = #{boardTyCd}
              AND abi.use_yn = 'Y'
        )
    </update>

    <select id="getTotalCount"
            resultType="int">
        /* IInqryMapper.getTotalCount */
        SELECT COUNT(*)
        FROM apt_board_post abp
                 JOIN apt_board_instance abi
                      ON abp.board_no = abi.board_no
        WHERE abi.apt_cmplex_no = #{aptCmplexNo}
          AND abi.board_ty_cd = #{boardTyCd}
          AND abi.use_yn = 'Y'
          AND abp.del_yn = 'N'
          AND abp.wrtr_id = #{wrtrId}
    </select>

    <select id="getResidentInfo"
            resultType="kr.or.ddit.domain.apt.board.inqry.dto.InqryDTO">
        /* IInqryMapper.getResidentInfo */
        SELECT
            hh.user_no        userNo        /* 사용자번호 */
             , hh.ho_no          hoNo          /* 세대번호 */
             , au.apt_cmplex_no  aptCmplexNo   /* 아파트단지번호 */
        FROM hshld_head hh
                 JOIN apt_detail ad
                      ON hh.ho_no = ad.ho_no
                 JOIN apt_unit au
                      ON ad.dong_no = au.dong_no
        WHERE hh.user_no = #{userNo}
          AND ROWNUM = 1
    </select>

</mapper>


